<?php
$plugins = $this->getHelperPluginManager();
$siteUrl = $plugins->has('config') ? ($this->config()['full_domain'] ?? null) : null;
$resetPath = $this->url('zfcuser/resetpassword', array('userId' => $this->record->getUserId(), 'token' => $this->record->getRequestKey()));
?>

<?php echo $this->translate('You have received this email because you initiated to reset your password with us. To continue with the process, please click the link below:'); ?>

<?php echo $siteUrl ? rtrim($siteUrl, '/') . $resetPath : $this->serverUrl($resetPath); ?>
